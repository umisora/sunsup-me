---
import Base from "../../layouts/Base.astro";
import { works, type Work } from "../../data/works";

export function getStaticPaths() {
  return works.map((work) => ({
    params: { slug: work.slug },
    props: { work },
  }));
}

interface Props {
  work: Work;
}

const { work } = Astro.props;
const image = work.slug === "portfolio" ? "/brand/og-image.png" : work.logo.src;
const tallyTotal = work.tally?.reduce((sum, row) => sum + row.count, 0);
---

<Base
  title={`${work.title} | Suns' Up Portfolio`}
  description={work.description}
  path={`/work/${work.slug}`}
  image={image}
>
  <div class="wrap">
    <header class="page-hero poster">
      <div class="copy">
        <p class="kicker">Work · {work.index}</p>
        <h1>{work.title}</h1>
        <p class="lede">{work.lede}</p>
        <div class="actions">
          {
            work.external && (
              <a class="btn solid" href={work.external.href} target="_blank" rel="noopener noreferrer">
                {work.external.label}
                <span class="sr-only"> (opens in a new tab)</span>
              </a>
            )
          }
          <a class="btn" href="/#work">All work</a>
          {work.slug === "consulting" && <a class="btn" href="/about/me#skills">Skills</a>}
          {work.slug === "portfolio" && <a class="btn solid" href="/">This site</a>}
        </div>
      </div>
      <div class="plate" data-tone={work.tone}>
        <img
          src={work.logo.src}
          width={work.logo.width}
          height={work.logo.height}
          alt={work.logo.alt}
          data-fit={work.logoFit}
          fetchpriority="high"
        />
      </div>
    </header>

    <section class:list={["sheet", { two: Boolean(work.tally) }]} aria-labelledby="summary-title">
      <div class="prose">
        <h2 id="summary-title">{work.summary}</h2>
        {work.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        {
          work.footnote && (
            <p class="note">
              {work.footnote}
              {work.slug === "consulting" && (
                <>
                  {" "}
                  <a href="/about/me#skills">About</a>
                </>
              )}
            </p>
          )
        }
      </div>
      {
        work.tally && tallyTotal !== undefined && (
          <div class="tally" aria-label="Drink list">
            <ol>
              {work.tally.map((row) => (
                <li>
                  <span>{row.code}</span>
                  <span>{row.label}</span>
                  <span>{row.count}</span>
                </li>
              ))}
            </ol>
            <p class="tally-total">
              <span>Listed bottles</span>
              <strong>{tallyTotal}</strong>
            </p>
          </div>
        )
      }
    </section>

    {
      work.facts && (
        <section class="sheet" aria-labelledby="facts-title">
          <div class="section-head">
            <h2 id="facts-title">What is published</h2>
          </div>
          <div class="facts">
            {work.facts.map((fact) => (
              <article class="fact">
                <h3>{fact.title}</h3>
                {fact.text && <p>{fact.text}</p>}
                {fact.items && (
                  <ul>
                    {fact.items.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                )}
              </article>
            ))}
          </div>
        </section>
      )
    }

    {
      work.shots && (
        <section class="sheet" aria-labelledby="shots-title">
          <div class="section-head">
            <h2 id="shots-title">Screens</h2>
          </div>
          <div class="shots">
            {work.shots.map((shot) => (
              <figure class="shot">
                <img
                  src={shot.src}
                  srcset={`${shot.small} 512w, ${shot.src} ${shot.width}w`}
                  sizes="(min-width: 960px) 46vw, 92vw"
                  width={shot.width}
                  height={shot.height}
                  alt={shot.alt}
                  loading="lazy"
                />
                <figcaption>{shot.caption}</figcaption>
              </figure>
            ))}
          </div>
        </section>
      )
    }
  </div>
</Base>
