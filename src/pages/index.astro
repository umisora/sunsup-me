---
import Base from "../layouts/Base.astro";
import HeroStage from "../components/HeroStage.astro";
import WorkVisual from "../components/WorkVisual.astro";
import { orderedWorks } from "../data/works";

const description =
  "Suns' Up is one person making products for small everyday problems.";
const terminal = "individual // products for the small problems in a day";
---

<Base title="Suns' Up Portfolio" description={description} path="/" image="/brand/og-image.png">
  <HeroStage
    titleId="home-title"
    kicker="Portfolio · individual"
    title="SUNS' UP"
    glitch="SUNS' UP"
    typed={terminal}
    poster
  >
    <div class="actions">
      <a class="btn solid" href="#work">Six products</a>
    </div>
  </HeroStage>

  <div class="wrap">
    <div class="section-head reveal" id="work">
      <h2>Work</h2>
      <p>Six products</p>
    </div>
    <div class="works">
      {
        orderedWorks().map((work) => (
          <article class="card reveal" data-layout={work.layout}>
            <a class="card-main" href={`/work/${work.slug}`}>
              <WorkVisual visual={work.visual} tone={work.tone} code={`SU-${work.index}`} />
              <div class="card-copy">
                <p class="idx">{work.index} / product</p>
                <h2>{work.title}</h2>
                <p>{work.card}</p>
                <p class="go">Open</p>
              </div>
            </a>
            {work.external && (
              <p class="card-foot">
                <a href={work.external.href} target="_blank" rel="noopener noreferrer">
                  {work.external.label}
                  <span class="sr-only"> (opens in a new tab)</span>
                </a>
              </p>
            )}
          </article>
        ))
      }
    </div>
  </div>
</Base>
